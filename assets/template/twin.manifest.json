{
  "schema": "tia-web-twin/manifest@1",
  "project": "sorting-line",
  "title": "输送带分拣线 · 数字孪生",
  "plc": {
    "family": "S7-1500",
    "ip": "192.168.0.1",
    "rack": 0,
    "slot": 1,
    "db": 1,
    "dbName": "TwinIO",
    "defaultPollHz": 10
  },
  "tags": [
    {
      "id": "cmd.start",
      "address": "DB1.DBX0.0",
      "type": "bool",
      "access": "rw",
      "writeMode": "pulse",
      "pulseMs": 200,
      "desc": "启动按钮（现场输入 -> PLC）",
      "mockInit": false
    },
    {
      "id": "cmd.stop",
      "address": "DB1.DBX0.1",
      "type": "bool",
      "access": "rw",
      "writeMode": "pulse",
      "pulseMs": 200,
      "desc": "停止按钮（现场输入 -> PLC）",
      "mockInit": false
    },
    {
      "id": "cmd.reset",
      "address": "DB1.DBX0.2",
      "type": "bool",
      "access": "rw",
      "writeMode": "pulse",
      "pulseMs": 200,
      "desc": "复位按钮（现场输入 -> PLC）",
      "mockInit": false
    },
    {
      "id": "cmd.estop",
      "address": "DB1.DBX0.3",
      "type": "bool",
      "access": "rw",
      "writeMode": "pulse",
      "pulseMs": 200,
      "desc": "急停按钮（现场输入 -> PLC）",
      "mockInit": false
    },
    {
      "id": "line.running",
      "address": "DB1.DBX0.4",
      "type": "bool",
      "access": "rw",
      "desc": "输送带运转（PLC 输出：1=转 0=停）",
      "mockInit": false
    },
    {
      "id": "out.cyl",
      "address": "DB1.DBX0.5",
      "type": "bool",
      "access": "rw",
      "desc": "推料气缸电磁阀（PLC 输出：1=伸出 0=缩回）",
      "mockInit": false
    },
    {
      "id": "sensor.pe1",
      "address": "DB1.DBX0.6",
      "type": "bool",
      "access": "rw",
      "writeMode": "pulse",
      "pulseMs": 300,
      "desc": "光电检测 PE1（现场输入 -> PLC）",
      "mockInit": false
    },
    {
      "id": "stack.green",
      "address": "DB1.DBX0.7",
      "type": "bool",
      "access": "rw",
      "desc": "运行指示灯（PLC 输出：1=亮 0=灭）",
      "mockInit": false
    },
    {
      "id": "box.count",
      "address": "DB1.DBB1",
      "type": "byte",
      "access": "rw",
      "desc": "分拣计数（PLC 内部数据/输出）",
      "mockInit": 0
    }
  ],
  "bindings": [
    { "object": "conveyor", "property": "running", "tag": "line.running" },
    { "object": "pe1", "property": "blocked", "tag": "sensor.pe1" },
    { "object": "pusher", "property": "command", "tag": "out.cyl" },
    { "object": "counter", "property": "value", "tag": "box.count" },
    { "object": "stack", "property": "green", "tag": "stack.green" }
  ]
}
