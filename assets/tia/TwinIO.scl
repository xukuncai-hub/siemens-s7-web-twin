// ==============================================================================
// TIA Portal 外部源文件
// 工程项目: sorting-line
// 自动生成自: twin.manifest.json (原生支持跨 DB)
// 说明：此数据块必须关闭【优化的块访问】，以确保固定物理地址对齐。
// 导入博途：项目树 -> 外部源文件 -> 添加此文件 -> 右键'从源文件生成块'
// ==============================================================================

DATA_BLOCK "TwinIO"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   STRUCT
      cmd_start : Bool; // DB1.DBX0.0: 启动按钮（现场输入 -> PLC）
      cmd_stop : Bool; // DB1.DBX0.1: 停止按钮（现场输入 -> PLC）
      cmd_reset : Bool; // DB1.DBX0.2: 复位按钮（现场输入 -> PLC）
      cmd_estop : Bool; // DB1.DBX0.3: 急停按钮（现场输入 -> PLC）
      line_running : Bool; // DB1.DBX0.4: 输送带运转（PLC 输出：1=转 0=停）
      out_cyl : Bool; // DB1.DBX0.5: 推料气缸电磁阀（PLC 输出：1=伸出 0=缩回）
      sensor_pe1 : Bool; // DB1.DBX0.6: 光电检测 PE1（现场输入 -> PLC）
      stack_green : Bool; // DB1.DBX0.7: 运行指示灯（PLC 输出：1=亮 0=灭）
      box_count : Byte; // DB1.DBB1: 分拣计数（PLC 内部数据/输出）
   END_STRUCT;

BEGIN
   cmd_start := FALSE;
   cmd_stop := FALSE;
   cmd_reset := FALSE;
   cmd_estop := FALSE;
   line_running := FALSE;
   out_cyl := FALSE;
   sensor_pe1 := FALSE;
   stack_green := FALSE;
   box_count := 0;
END_DATA_BLOCK
