// TIA Portal 外部源文件: TwinDemoLogic.scl
// 工程项目: smt-pick-and-place
// 配套示例控制逻辑（可在 OB1 'Main' 中直接调用）
// 说明：导入博途 -> 外部源文件 -> 添加此文件 -> 右键'从源文件生成块'
// 调用方法：在 OB1 中插入一行: "TwinDemoLogic"(); 即可驱动数字孪生！
// ==============================================================================

FUNCTION "TwinDemoLogic" : Void
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
VAR_TEMP
END_VAR

BEGIN
   // ---------------------------------------------------------------------------
   // 1. 启停与急停控制 (Start / Stop / E-Stop Latch)
   // ---------------------------------------------------------------------------
   IF "TwinIO".cmd_estop THEN
   ELSIF "TwinIO".cmd_start THEN
   ELSIF "TwinIO".cmd_stop THEN
   END_IF;

   // ---------------------------------------------------------------------------
   // 2. 输送带运转中：物料感应触发分拣推料与计数
   // ---------------------------------------------------------------------------
END_FUNCTION
