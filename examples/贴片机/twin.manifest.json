{
  "schema": "tia-web-twin/manifest@1",
  "project": "smt-pick-and-place",
  "title": "SMT 高速贴片机生产线 · 数字孪生与上位机",
  "plc": {
    "family": "S7-1500",
    "ip": "192.168.0.1",
    "rack": 0,
    "slot": 1,
    "db": 1,
    "dbName": "TwinIO",
    "defaultPollHz": 10
  },
  "tags": [
    {
      "id": "cmd.start",
      "address": "DB1.DBX0.0",
      "type": "bool",
      "access": "rw",
      "writeMode": "pulse",
      "pulseMs": 200,
      "desc": "产线启动按钮（上位机 -> PLC）",
      "mockInit": false
    },
    {
      "id": "cmd.stop",
      "address": "DB1.DBX0.1",
      "type": "bool",
      "access": "rw",
      "writeMode": "pulse",
      "pulseMs": 200,
      "desc": "产线停止按钮（上位机 -> PLC）",
      "mockInit": false
    },
    {
      "id": "cmd.reset",
      "address": "DB1.DBX0.2",
      "type": "bool",
      "access": "rw",
      "writeMode": "pulse",
      "pulseMs": 200,
      "desc": "报警复位按钮（上位机 -> PLC）",
      "mockInit": false
    },
    {
      "id": "cmd.estop",
      "address": "DB1.DBX0.3",
      "type": "bool",
      "access": "rw",
      "writeMode": "pulse",
      "pulseMs": 200,
      "desc": "安全急停按钮（上位机 -> PLC）",
      "mockInit": false
    },
    {
      "id": "smt.running",
      "address": "DB1.DBX0.4",
      "type": "bool",
      "access": "rw",
      "desc": "贴片机总运行状态（PLC 输出：1=运转 0=停止）",
      "mockInit": true
    },
    {
      "id": "smt.paused",
      "address": "DB1.DBX0.5",
      "type": "bool",
      "access": "rw",
      "desc": "贴片机暂停保持状态",
      "mockInit": false
    },
    {
      "id": "smt.alarm_active",
      "address": "DB1.DBX0.6",
      "type": "bool",
      "access": "rw",
      "desc": "贴片机报警激活状态",
      "mockInit": false
    },
    {
      "id": "smt.xray_mode",
      "address": "DB1.DBX0.7",
      "type": "bool",
      "access": "rw",
      "desc": "外壳透视观察模式状态",
      "mockInit": false
    },
    {
      "id": "sens.infeed_pe",
      "address": "DB1.DBX1.0",
      "type": "bool",
      "access": "rw",
      "desc": "上板进入光电检测传感器",
      "mockInit": true
    },
    {
      "id": "sens.clamped",
      "address": "DB1.DBX1.1",
      "type": "bool",
      "access": "rw",
      "desc": "PCB 工作台定位气缸夹紧到位",
      "mockInit": true
    },
    {
      "id": "sens.vision_ok",
      "address": "DB1.DBX1.2",
      "type": "bool",
      "access": "rw",
      "desc": "飞行视觉相机对准识别合格信号",
      "mockInit": true
    },
    {
      "id": "sens.placed_ok",
      "address": "DB1.DBX1.3",
      "type": "bool",
      "access": "rw",
      "desc": "单板贴装全部就绪信号",
      "mockInit": false
    },
    {
      "id": "sens.reflow_in",
      "address": "DB1.DBX1.4",
      "type": "bool",
      "access": "rw",
      "desc": "回流焊入口光电检测",
      "mockInit": true
    },
    {
      "id": "sens.aoi_result",
      "address": "DB1.DBX1.5",
      "type": "bool",
      "access": "rw",
      "desc": "AOI 光学检测判定结果 (1=OK 0=NG)",
      "mockInit": true
    },
    {
      "id": "sens.outfeed_pe",
      "address": "DB1.DBX1.6",
      "type": "bool",
      "access": "rw",
      "desc": "收料机出板光电检测",
      "mockInit": false
    },
    {
      "id": "smt.feeder_index",
      "address": "DB1.DBW2",
      "type": "int16",
      "access": "rw",
      "desc": "当前执行取料的飞达料站索引号 (1-12)",
      "mockInit": 1
    },
    {
      "id": "smt.axis_x",
      "address": "DB1.DBD4",
      "type": "real",
      "access": "rw",
      "desc": "X 轴贴装小车当前绝对物理坐标 (mm)",
      "mockInit": 142.5
    },
    {
      "id": "smt.axis_y",
      "address": "DB1.DBD8",
      "type": "real",
      "access": "rw",
      "desc": "Y 轴双驱龙门横梁当前绝对物理坐标 (mm)",
      "mockInit": -218.4
    },
    {
      "id": "smt.axis_z",
      "address": "DB1.DBD12",
      "type": "real",
      "access": "rw",
      "desc": "Z 轴吸嘴当前行程深度 (mm)",
      "mockInit": 0.0
    },
    {
      "id": "smt.vacuum_kpa",
      "address": "DB1.DBD16",
      "type": "real",
      "access": "rw",
      "desc": "工作吸嘴实时真空负压 (kPa)",
      "mockInit": -84.2
    },
    {
      "id": "smt.cph",
      "address": "DB1.DBD20",
      "type": "real",
      "access": "rw",
      "desc": "实时贴片生产速度 (Chips Per Hour)",
      "mockInit": 43200.0
    },
    {
      "id": "smt.yield_rate",
      "address": "DB1.DBD24",
      "type": "real",
      "access": "rw",
      "desc": "综合良品率统计百分比 (%)",
      "mockInit": 99.88
    },
    {
      "id": "smt.total_count",
      "address": "DB1.DBD28",
      "type": "int32",
      "access": "rw",
      "desc": "今日已下线合格 PCB 总计数 (PCS)",
      "mockInit": 2864
    },
    {
      "id": "smt.reflow_temp_peak",
      "address": "DB1.DBD32",
      "type": "real",
      "access": "rw",
      "desc": "回流焊炉第6峰值温区实时测量温度 (°C)",
      "mockInit": 246.5
    },
    {
      "id": "smt.alarm_code",
      "address": "DB1.DBW36",
      "type": "int16",
      "access": "rw",
      "desc": "当前报警故障码 (0=正常, 1=飞达缺料, 2=视觉偏位超差, 3=温控波动)",
      "mockInit": 0
    }
  ],
  "bindings": [
    { "object": "gantry_y", "property": "position_y", "tag": "smt.axis_y" },
    { "object": "head_x", "property": "position_x", "tag": "smt.axis_x" },
    { "object": "nozzle_z", "property": "depth_z", "tag": "smt.axis_z" },
    { "object": "smt_machine", "property": "running", "tag": "smt.running" },
    { "object": "vacuum_sensor", "property": "pressure", "tag": "smt.vacuum_kpa" },
    { "object": "tower_light", "property": "alarm", "tag": "smt.alarm_active" },
    { "object": "infeed_sensor", "property": "blocked", "tag": "sens.infeed_pe" },
    { "object": "pcb_clamp", "property": "clamped", "tag": "sens.clamped" },
    { "object": "aoi_camera", "property": "inspect_ok", "tag": "sens.aoi_result" },
    { "object": "reflow_oven", "property": "peak_temp", "tag": "smt.reflow_temp_peak" }
  ]
}
